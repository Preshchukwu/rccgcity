generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FacilityCategory {
  toilet
  auditorium
  food
  medical
  parking
  shuttle
  hotel
  accommodation
}

enum FacilityStatus {
  open
  closed
  crowded
  maintenance
}

enum ReportType {
  comment
  issue
}

enum ReportSeverity {
  low
  medium
  high
}

enum ReportCategory {
  cleanliness
  accessibility
  crowd
  damage
  other
}

enum GuideRequestStatus {
  pending
  contacted
  resolved
}

model Facility {
  id          String           @id @default(cuid())
  name        String
  category    FacilityCategory
  description String?
  status      FacilityStatus   @default(open)
  latitude    Float
  longitude   Float
  images      String[]
  updatedAt   DateTime         @updatedAt
  createdAt   DateTime         @default(now())
  reports     Report[]
}

model Report {
  id          String          @id @default(cuid())
  facilityId  String
  facility    Facility        @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  type        ReportType
  description String
  photoUrl    String?
  severity    ReportSeverity?
  category    ReportCategory?
  isHidden    Boolean         @default(false)
  createdAt   DateTime        @default(now())
}

model BannerCard {
  id           String   @id @default(cuid())
  title        String
  subtitle     String?
  imageUrl     String?
  linkUrl      String?
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TourGuideRequest {
  id                String             @id @default(cuid())
  fullName          String
  email             String
  phone             String
  nationality       String
  arrivalDate       DateTime
  preferredLanguage String
  message           String?
  status            GuideRequestStatus @default(pending)
  createdAt         DateTime           @default(now())
}

model EmergencyReport {
  id                  String   @id @default(cuid())
  name                String
  issueDescription    String
  locationDescription String
  createdAt           DateTime @default(now())
}
